APP_NAME=Loggerxo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://loggerxo.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- MariaDB: users, organizations, projects, issues, alert rules
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loggerxo
DB_USERNAME=loggerxo
DB_PASSWORD=

# ---- Redis: ingest queue, cache, sessions, rate limits
# phpredis extension ships in the Docker image; use predis only where the extension is missing (local dev)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- ClickHouse: events, logs, transactions (HTTP interface)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_PROTOCOL=http
CLICKHOUSE_DB=app
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT=30

# ---- Ingest tuning
INGEST_WORKERS=2
INGEST_BATCH_SIZE=500
INGEST_BATCH_WAIT_MS=1500
INGEST_RATE_LIMIT_PER_MINUTE=6000
INGEST_MAX_BODY_KB=2048
DEFAULT_RETENTION_DAYS=30

# ---- Mail: Cloudflare Email Service (REST API). Fallback: set MAIL_MAILER=smtp or log.
MAIL_MAILER=cloudflare
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_BASE_URL=https://api.cloudflare.com/client/v4
MAIL_FROM_ADDRESS="no-reply@loggerxo.com"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP fallback (only used when MAIL_MAILER=smtp)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null

# ---- Telegram (optional global bot; projects can also set their own token)
TELEGRAM_BOT_TOKEN=

# ---- Registration
REGISTRATION_ENABLED=true
# Comma separated e-mails that become super admins on registration/login
SUPER_ADMIN_EMAILS=

VITE_APP_NAME="${APP_NAME}"
