{
	admin off
	auto_https off
	frankenphp {
		num_threads 16
	}
}

:80 {
	root * /app/public
	encode zstd br gzip

	header -Server
	header -X-Powered-By

	@immutable path /build/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Browser SDK: short cache so updates roll out quickly, CORS so any site can load it.
	@sdk path /sdk/*
	header @sdk Cache-Control "public, max-age=3600"
	header @sdk Access-Control-Allow-Origin "*"

	php_server {
		index index.php
	}

	file_server

	request_body {
		max_size 10MB
	}
}
